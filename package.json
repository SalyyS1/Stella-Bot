{
  "name": "minecraft-community-bot",
  "version": "1.0.0",
  "description": "Discord Bot cho cộng đồng Minecraft (HelpChat Clone)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npx prisma generate && tsc",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:import:sqlite": "node scripts/import-sqlite-to-postgres.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "db:verify": "node scripts/verify-db.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.99",
    "@prisma/client": "^5.0.0",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.2",
    "dotenv": "^16.6.1",
    "minecraft-server-util": "^5.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}

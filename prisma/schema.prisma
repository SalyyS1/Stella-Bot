generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id // Discord User ID
  // Hệ thống Level
  xp            Int      @default(0)
  level         Int      @default(1)
  totalMessages Int      @default(0)
  expertScore   Int      @default(0)
  contributionScore Int @default(0)
  scoinBalance  Int      @default(0)
  scoinEarnedTotal Int   @default(0)
  // Hệ thống Daily
  lastDaily     DateTime?
  dailyStreak   Int      @default(0)
  // Nhiệm vụ ngày: streak = số ngày liên tiếp hoàn thành đủ quest trong ngày
  questStreak   Int      @default(0)
  lastQuestDay  String?  // ngày (Asia/Saigon, yyyy-MM-dd) gần nhất hoàn thành đủ quest
  createdAt     DateTime @default(now())
  // Onboarding / freelancer retention (Phase 5)
  joinedAt      DateTime? // persisted on guildMemberAdd; enables 7-day retention metric
  hasPortfolio  Boolean  @default(false) // set on first portfolio post (first-portfolio detection)
  verifiedAt    DateTime? // set when a mod approves the Verified Freelancer role

  scoinTransactions ScoinTransaction[]
  musicPlaylistTracks MusicPlaylistTrack[]
  musicPlaylists MusicPlaylist[]
  starInventory StarInventory?
  starItems StarItemStack[]
  starTools StarTool[]
  starBuffs StarBuff[]
  giveawayEntries GiveawayEntry[]
  requestClaims RequestClaim[]
  requestReviews RequestReview[] @relation("RequestReviewer")
  receivedRequestReviews RequestReview[] @relation("RequestReviewTarget")
  memberFacts MemberFact[]
  dailyQuests DailyQuest[]
  shopPurchases ShopPurchase[]
  weeklyActivity WeeklyActivity[]
  birthday Birthday?
}

model GuildSettings {
  guildId    String   @id
  locale     String   @default("vi")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Blacklist {
  id        String   @id // Discord User ID
  reason    String
  addedBy   String
  createdAt DateTime @default(now())
}

model Vote {
  id             Int      @id @default(autoincrement())
  messageId      String
  channelId      String
  targetAuthorId String
  voterId        String
  value          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([messageId, voterId])
  @@index([channelId])
  @@index([targetAuthorId])
}

model ShowcasePost {
  messageId     String   @id
  channelId     String
  authorId      String
  title         String
  tagName       String   @default("Nothing")
  status        String   @default("VOTING")
  forumThreadId String?
  dmMessageId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@index([authorId])
  @@index([status])
}

model MaintenanceLog {
  id        Int      @id @default(autoincrement())
  channelId String
  kind      String
  period    String
  actorId   String?
  createdAt DateTime @default(now())

  @@unique([channelId, kind, period])
}

model ManagedChannel {
  key       String   @id
  channelId String
  updatedAt DateTime @updatedAt
}

model ScoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int
  reason    String
  source    String
  metadata  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([createdAt])
}

model MusicPlaylistTrack {
  id        Int      @id @default(autoincrement())
  userId    String
  position  Int
  title     String
  uri       String
  source    String?
  duration  Int?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([userId])
}

// Playlist v2: mỗi người nhiều playlist, có tên + ảnh bìa + mã share.
// MusicPlaylistTrack ở trên là bảng cũ (1 playlist phẳng/người), giữ lại tới khi
// đã xác minh dữ liệu backfill sang đây đủ.
model MusicPlaylist {
  id             Int      @id @default(autoincrement())
  userId         String
  name           String
  description    String?
  // Ảnh bìa: hoặc link https người dùng dán (coverUrl), hoặc message id của ảnh
  // đã re-upload vào asset channel (coverMessageId). Không lưu URL attachment
  // Discord vì URL đó có signature hết hạn sau vài ngày.
  coverUrl       String?
  coverMessageId String?
  isPublic       Boolean  @default(false)
  shareCode      String   @unique
  playCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks MusicPlaylistItem[]

  @@unique([userId, name])
  @@index([userId])
}

model MusicPlaylistItem {
  id         Int      @id @default(autoincrement())
  playlistId Int
  position   Int
  title      String
  author     String?
  uri        String
  // Lưu identifier để phát lại đúng bài thay vì search lại theo tên.
  identifier String?
  source     String?
  duration   Int?
  artworkUrl String?
  addedAt    DateTime @default(now())

  playlist MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId])
}

model StarInventory {
  userId       String   @id
  dust         Int      @default(0)
  small        Int      @default(0)
  bright       Int      @default(0)
  comet        Int      @default(0)
  galaxy       Int      @default(0)
  lastHuntAt   DateTime?
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StarItemStack {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model StarTool {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model StarBuff {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StarHarvestSession {
  id        Int      @id @default(autoincrement())
  userId    String
  toolKey   String
  result    String
  soldValue Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Giveaway {
  id              Int      @id @default(autoincrement())
  messageId       String?  @unique
  channelId       String
  title           String
  description     String
  prize           String
  hostId          String
  pingRoleId      String?
  winnersCount    Int
  endsAt          DateTime
  status          String   @default("ACTIVE")
  requiredRoleId  String?
  minLevel        Int?
  minScoin        Int?
  entryCost       Int      @default(0)
  rewardType      String   @default("contact_host")
  rewardSecret    String?
  publicMediaUrl  String?
  bannerUrl       String?
  winnerIds       String?
  // Ưu tiên tỷ lệ trúng theo lượt mời. "none" giữ hành vi quay đều như cũ, nên
  // giveaway đang chạy lúc migrate không bị đổi luật giữa cuộc.
  inviteBonusMode String   @default("none") // none | all_time | since_start
  inviteWeightPer Int      @default(1) // số vé cộng thêm cho mỗi lượt mời
  inviteWeightCap Int      @default(10) // trần vé cộng thêm — chặn một người ăn cả
  inviteCountFrom DateTime? // mốc bắt đầu đếm cho chế độ since_start
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries         GiveawayEntry[]
  deliveries      GiveawayRewardDelivery[]

  @@index([status])
  @@index([endsAt])
}

model GiveawayEntry {
  id          Int      @id @default(autoincrement())
  giveawayId  Int
  userId      String
  entries     Int      @default(1)
  joinedAt    DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([userId])
}

model GiveawayRewardDelivery {
  id          Int      @id @default(autoincrement())
  giveawayId  Int
  userId      String
  status      String
  error       String?
  createdAt   DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@index([giveawayId])
  @@index([userId])
}

model RequestPost {
  id            Int      @id @default(autoincrement())
  messageId     String?  @unique
  channelId     String
  requesterId   String
  kind          String
  service       String
  skill         String?
  description   String
  budget        String?  // nguyên văn người dùng gõ, giữ lại cho đơn cũ
  budgetAmount  Int?     // giá đã chuẩn hoá: sort/lọc/thống kê đi qua cột này
  budgetCurrency String? // VND / USD
  dueDate       DateTime?
  ticketChannelId String? @unique // kênh riêng của đơn, tạo khi có người nhận
  referenceUrls String?  // JSON array URL ảnh tham khảo. URL CDN Discord HẾT HẠN — chỉ để xem ngay
  other         String?
  status        String   @default("OPEN")
  claimedById   String?
  completedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  claims        RequestClaim[]
  reviews       RequestReview[]

  @@index([requesterId])
  @@index([status])
  @@index([kind])
  @@index([budgetAmount])
  @@index([dueDate])
}

model RequestClaim {
  id          Int      @id @default(autoincrement())
  requestId   Int
  claimerId   String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     RequestPost @relation(fields: [requestId], references: [id], onDelete: Cascade)
  claimer     User        @relation(fields: [claimerId], references: [id], onDelete: Cascade)

  @@unique([requestId, claimerId])
  @@index([claimerId])
  @@index([status])
}

model RequestReview {
  id          Int      @id @default(autoincrement())
  requestId   Int
  reviewerId  String
  targetId    String
  rating      Int
  note        String?
  createdAt   DateTime @default(now())

  request     RequestPost @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("RequestReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  target      User        @relation("RequestReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requestId, reviewerId])
  @@index([targetId])
}

// Hồ sơ nhận việc do freelancer tự khai: đang nhận việc không, giới thiệu, bảng giá.
// Tách khỏi User (bảng đó đã 20+ cột, 15 quan hệ) và để có updatedAt riêng — bảng giá
// lâu chưa sửa là bảng giá gây hiểu lầm, hiển thị phải nói rõ lần cập nhật cuối.
// Bảng giá là văn bản, KHÔNG phải số có cấu trúc như RequestPost.budgetAmount: giá đơn
// hàng cần sort/lọc/thống kê, bảng giá cá nhân chỉ để đọc.
model FreelancerProfile {
  userId      String   @id
  openForWork Boolean  @default(true)
  headline    String?
  priceText   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([openForWork])
}

model FacebookCrossPost {
  id              Int      @id @default(autoincrement())
  sourceChannelId String   // channel of the source Discord message (for live URL re-fetch)
  sourceMessageId String   // source message id — re-fetch a LIVE signed URL at approval time
  authorId        String
  caption         String
  status          String   @default("PENDING") // PENDING | PUBLISHING | PUBLISHED | DISCARDED | NEEDS_REVIEW
  fbPostId        String?
  lastError       String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model WikiEntry {
  name      String   @id // lowercased plugin key
  url       String
  aliases   String?  // optional CSV of alternate names
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberFact {
  id        Int      @id @default(autoincrement())
  userId    String
  fact      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fact])
  @@index([userId])
}

// Nhiệm vụ ngày: mỗi người 3 quest ngẫu nhiên / ngày (gán lazy khi có hoạt động
// đầu tiên). Hoàn thành tự cộng Scoin; unique chặn gán trùng khi race.
model DailyQuest {
  id        Int      @id @default(autoincrement())
  userId    String
  day       String   // ngày Asia/Saigon, yyyy-MM-dd
  questKey  String   // khóa catalog trong quest-manager (chat/daily/trivia/vote/star)
  target    Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  reward    Int      // Scoin trả khi hoàn thành

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, questKey])
  @@index([userId, day])
}

// Role màu do Stella tự tạo cho Shop; lưu id để tái dùng thay vì tạo lại.
model ShopColorRole {
  key       String   @id // khóa màu trong config.shop.colors
  roleId    String
  createdAt DateTime @default(now())
}

// Nhật ký mua hàng Shop (đối soát; số dư trừ qua ScoinTransaction).
model ShopPurchase {
  id        Int      @id @default(autoincrement())
  userId    String
  itemKey   String
  price     Int
  // PENDING = đã trừ xu, chưa giao xong. DELIVERED = đã giao. REFUNDED = đã hoàn xu.
  // Trạng thái là thứ chặn "hoàn xu rồi vẫn đổi được hàng": đơn REFUNDED không còn
  // là bằng chứng đã trả tiền. Không có nó thì hoàn xu và nhận hàng là hai đường
  // độc lập, đi cả hai là được hàng miễn phí.
  status      String    @default("DELIVERED")
  deliveredAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, itemKey])
}

// Hoạt động theo tuần (weekKey = ngày thứ 2 đầu tuần Asia/Saigon, yyyy-MM-dd).
// Cộng dồn từ hook XP; dùng để xếp hạng thưởng tuần.
model WeeklyActivity {
  userId   String
  weekKey  String
  messages Int    @default(0)
  xp       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekKey])
  @@index([weekKey])
}

// Chốt mỗi tuần chỉ trao thưởng 1 lần: insert (unique weekKey) TRƯỚC khi trao —
// restart giữa chừng không thể trao lần 2.
model WeeklyRewardRun {
  weekKey String   @id
  ranAt   DateTime @default(now())
}

// Sinh nhật thành viên tự đăng ký. lastCelebratedYear chặn chúc trùng trong năm.
model Birthday {
  userId             String   @id
  day                Int
  month              Int
  lastCelebratedYear Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month, day])
}

// Bản tóm tắt trung gian của nhật báo: mỗi 3h một "slot" (0..7) được tóm tắt và
// lưu ở đây, KHÔNG đăng lên kênh. Cuối ngày 8 slot được gộp lại thành bản tin
// hoàn chỉnh. Lưu ở DB thay vì file tạm vì host là shared hosting — filesystem
// có thể bị xoá khi restart, còn Postgres là nguồn bền duy nhất của bot.
// summary rỗng + msgCount 0 = slot đó thật sự không có chat (đã kiểm tra, không
// phải lỗi) — ghi lại để scheduler không thử lại vô hạn.
model ReportChunk {
  id        Int      @id @default(autoincrement())
  period    String // ngày theo timezone cấu hình, yyyy-MM-dd
  slot      Int // 0..7, mốc 3 giờ
  summary   String
  msgCount  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([period, slot])
  @@index([period])
}

// BÀI nhật báo ĐÃ ĐĂNG (bản tin ngày hoàn chỉnh, không phải chunk trung gian).
// Chunk 3h bị prune sau 7 ngày và không phải là bài hoàn chỉnh — bài tổng hợp
// tuần (report-weekly) cần đọc lại các bài ngày, nên bài đăng xong phải được lưu
// riêng ở đây. Prune 35 ngày (xem report-daily-store.ts) — 1 row/ngày, không lo phình.
model ReportDaily {
  id        Int      @id @default(autoincrement())
  period    String   @unique // ngày theo timezone cấu hình, yyyy-MM-dd
  body      String
  createdAt DateTime @default(now())
}

// Lời nhắc do member nhờ Stella ping hộ, đặt bằng câu nói thường trong `!s`.
//
// Vì sao phải lưu DB chứ không setTimeout: một lời nhắc "3h chiều nay" đặt lúc
// 9h sáng phải sống qua mọi lần bot restart/deploy giữa khoảng đó. setTimeout
// mất trắng khi process chết, và mất một lời nhắc thì người ta không biết là
// mình đã bị quên — đúng kiểu thất bại tệ nhất cho một tính năng nhắc nhở.
//
// requesterId TÁCH RIÊNG targetId là chốt quyền, không phải để thống kê: chỉ
// role được cấp mới đặt được lời nhắc cho NGƯỜI KHÁC, còn ai cũng đặt được cho
// chính mình. Thiếu tách hai cột này thì không truy được ai đã nhờ ping ai.
model Reminder {
  id          Int       @id @default(autoincrement())
  requesterId String // ai nhờ đặt (dùng để truy vết và kiểm quyền)
  targetId    String // ai bị ping khi tới giờ
  channelId   String // ping ở kênh nào (mặc định kênh chat)
  message     String // nội dung nhắc, do người đặt nói
  // Mốc giờ TIẾP THEO cần ping, tính sẵn theo giờ VN rồi lưu về UTC. Lưu mốc
  // tuyệt đối thay vì "3h chiều" dạng chữ để scheduler chỉ cần so sánh thời
  // gian, không phải parse lại tiếng Việt mỗi phút.
  nextFireAt  DateTime
  // Lặp hằng ngày hay chỉ một lần. Lời nhắc một lần được đánh done sau khi ping;
  // lời lặp thì dời nextFireAt sang cùng giờ ngày mai.
  repeatDaily Boolean   @default(false)
  // Giờ/phút theo giờ VN, giữ lại RIÊNG cho lời lặp: cộng thêm 24h vào mốc UTC
  // sẽ lệch nếu múi giờ đổi, còn dựng lại từ giờ-phút thì luôn đúng "1h chiều
  // theo giờ Hà Nội" bất kể chuyện gì xảy ra với offset.
  hourVn      Int
  minuteVn    Int       @default(0)
  active      Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Chỉ quét lời nhắc còn sống và đã tới hạn.
  @@index([active, nextFireAt])
  @@index([targetId])
}

// Tên gợi nhớ: "Ri" -> user id thật. Để Saly nói "nhắc Ri đi tắm" mà không phải
// ping, vì ping thì phải mở danh sách member tìm đúng người — đúng cái việc mà
// tính năng nhắc nhở định bỏ đi.
//
// Vì sao là bảng DB chứ không phải hằng trong config: thêm một tên là việc Saly
// làm lúc đang chat, còn sửa config thì phải deploy lại bot. Lưu DB nên thêm được
// bằng lệnh và sống qua restart.
//
// alias là khoá chính đã lowercase: tra tên phải không phân biệt hoa thường ("ri",
// "Ri", "RI" là một người), mà so sánh lowercase trên khoá tự nhiên thì DB tự
// chặn trùng luôn — không cần thêm chốt ở tầng code.
model ReminderAlias {
  alias     String   @id // đã lowercase
  userId    String // người mà tên này chỉ tới
  // Ai thêm. Giữ lại để truy vết: một tên trỏ sai người sẽ ping oan người đó mỗi
  // ngày, nên phải biết ai đặt để hỏi lại.
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Thuật ngữ cộng đồng mà Stella chưa hiểu. Vòng đời: phát hiện trong chat (kèm
// lượt tóm tắt chunk, không tốn AI call riêng) -> hỏi ở kênh knowledge -> chỉ ghi
// nghĩa khi NGƯỜI CÓ ROLE TIN CẬY trả lời. answeredBy + sourceMsg để truy vết và
// xoá được khi bị dạy sai — một nghĩa sai sẽ được tái dùng ở mọi bản tin sau, nên
// phải sửa được. askedAt/askCount để không hỏi lại cùng một từ mỗi 3 tiếng.
model GlossaryTerm {
  term       String    @id // đã lowercase, dùng làm khoá tự nhiên
  meaning    String? // null = đã hỏi nhưng chưa ai trả lời
  answeredBy String? // Discord user id của người giải thích
  sourceMsg  String? // message id để truy vết nguồn
  askedAt    DateTime?
  askCount   Int       @default(0)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([answeredAt])
}

// Ảnh chụp số lượt dùng của mọi invite. Đây là mốc so sánh DUY NHẤT để biết ai
// mời ai: Discord không nói invite nào vừa được dùng lúc member join, chỉ có thể
// fetch lại toàn bộ invite rồi tìm mã nào tăng `uses`. Không có bảng này thì sau
// mỗi lần restart bot sẽ không quy được lượt mời nào nữa.
model InviteCache {
  code      String    @id
  inviterId String? // null = vanity / invite của bot / không rõ người tạo
  uses      Int       @default(0)
  maxUses   Int       @default(0)
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([inviterId])
}

// Một lượt join = một dòng. invitedId là KHOÁ CHÍNH nên vào lại không tạo dòng
// mới — chặn kiểu farm "mời rồi cho rời rồi mời lại" bằng chính hình dạng bảng
// thay vì bằng một chốt ở tầng code có thể bị bỏ qua ở nhánh khác.
model InviteJoin {
  invitedId        String    @id
  inviterId        String
  code             String?
  source           String // INVITE | VANITY | UNKNOWN
  status           String    @default("PENDING") // PENDING | VERIFIED | REJECTED_YOUNG | LEFT | REVOKED
  accountCreatedAt DateTime?
  joinedAt         DateTime  @default(now())
  rolePickedAt     DateTime? // mốc hoàn thành nhiệm vụ chọn role ở kênh welcome
  verifiedAt       DateTime?
  leftAt           DateTime?
  rejoinCount      Int       @default(0)
  note             String? // lý do admin ép duyệt / thu hồi

  @@index([inviterId, status])
  @@index([status, joinedAt])
}

// Số lượt mời trong quá khứ, ĐÓNG BĂNG ở lần quét đầu tiên.
//
// Discord không có API lịch sử "ai mời ai" — chỉ suy ra được tổng `uses` của các
// invite CÒN TỒN TẠI. Nếu quét lại sau khi hệ thống đã chạy thì `uses` đã bao gồm
// cả những lượt join đã được đếm chính xác ở InviteJoin.VERIFIED, cộng hai nguồn
// vào nhau là đếm đôi. Vì vậy con số này chỉ được ghi một lần và không tự quét lại.
model InviteBackfill {
  inviterId  String   @id
  legacyUses Int      @default(0)
  frozenAt   DateTime @default(now())
}

// Bản sao tin nhắn, giữ 14 ngày (30 ngày nếu đã bị xoá/sửa).
//
// Vì sao phải có: Discord chỉ trả nội dung tin cũ trong event messageDelete/
// messageUpdate NẾU tin còn nằm trong cache RAM (mặc định 200 tin/kênh, mất sạch
// mỗi lần bot restart). Không có bảng này thì log "tin bị xoá" chỉ ra được cái vỏ —
// ai, kênh nào, lúc nào — còn nội dung, thứ duy nhất cần để phân xử, thì mất.
model MessageMirror {
  messageId    String    @id
  channelId    String
  authorId     String
  content      String // nội dung HIỆN TẠI, cập nhật sau mỗi lần sửa
  attachments  String? // JSON [{name,url,size,contentType}]
  stickerNames String?
  replyToId    String?
  createdAt    DateTime // thời điểm gửi thật, không phải lúc mirror
  editedAt     DateTime?
  editCount    Int       @default(0)
  deletedAt    DateTime?
  deletedBy    String? // lấy từ audit log; null = tự xoá
  mirroredAt   DateTime  @default(now())

  versions MessageVersion[]

  @@index([authorId, createdAt])
  @@index([channelId, createdAt])
  @@index([mirroredAt])
  @@index([deletedAt])
}

// Từng phiên bản nội dung của một tin. version 1 = bản gốc, được chèn vào lúc sửa
// lần đầu (trước đó không có gì để so nên không cần dòng nào).
model MessageVersion {
  id        Int      @id @default(autoincrement())
  messageId String
  version   Int
  content   String
  changedAt DateTime @default(now())

  message MessageMirror @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@unique([messageId, version])
  @@index([messageId])
}

// Hồ sơ kỷ luật. Ban/kick/timeout do mod làm BẰNG TAY cũng được ghi tự động từ
// audit log: nếu chỉ ghi khi mod dùng lệnh của bot thì hồ sơ sẽ trống đúng vào
// những ca xử lý gấp — tức là những ca cần tra lại nhất.
model ModCase {
  id        Int       @id @default(autoincrement())
  targetId  String
  actorId   String
  kind      String // WARN | NOTE | TIMEOUT | KICK | BAN | UNBAN | GHOST_PING | WATCH
  reason    String?
  evidence  String? // link tin nhắn hoặc message id
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([targetId, createdAt])
  @@index([actorId])
  @@index([kind])
}

// Role lúc rời server, để trả lại khi vào lại. Mục đích chính là chống né mute:
// rời rồi vào lại là cách gỡ mute nhanh nhất và không để lại dấu vết nào.
model StickyRole {
  userId  String   @id
  roleIds String // CSV role id lúc rời
  savedAt DateTime @default(now())
}

// Cấu hình automod, một dòng cho mỗi server.
//
// Vì sao ở DB mà không ở config.ts như phần còn lại của bot: automod là thứ phải
// tắt/bật được GIỮA một đợt spam, mà sửa config.ts thì phải deploy lại bot. Ngưỡng
// mặc định vẫn nằm trong config.ts; bảng này chỉ ghi phần đã bị đổi.
//
// `rules` là JSON thay vì 30 cột: mỗi luật có hình dạng tham số khác nhau (ngưỡng,
// danh sách từ, cửa sổ thời gian), và thêm một luật mới không nên cần một migration.
model AutomodSetting {
  guildId          String   @id
  enabled          Boolean  @default(true)
  rules            String // JSON: { ruleKey: { enabled, action, ...params } }
  exemptRoleIds    String? // CSV
  exemptChannelIds String? // CSV
  updatedAt        DateTime @updatedAt
}

// Lượt vi phạm automod. Dùng để leo thang hình phạt (xoá → cảnh cáo → timeout) và
// để mod thấy được ai đang liên tục chạm luật thay vì chỉ thấy từng lần rời rạc.
model AutomodStrike {
  id        Int      @id @default(autoincrement())
  userId    String
  rule      String
  channelId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Menu nhận role tự chọn (thay reaction role của Carl-bot).
//
// mode: multi = chọn bao nhiêu cũng được; unique = chỉ giữ một role trong menu;
// verify = chỉ cấp, không cho bỏ (dùng cho cổng xác minh).
model RoleMenu {
  id          Int      @id @default(autoincrement())
  channelId   String
  messageId   String?  @unique
  title       String
  description String
  mode        String   @default("multi") // multi | unique | verify
  style       String   @default("button") // button | select
  createdBy   String
  createdAt   DateTime @default(now())

  options RoleMenuOption[]
}

model RoleMenuOption {
  id          Int     @id @default(autoincrement())
  menuId      Int
  roleId      String
  label       String
  emoji       String?
  description String?
  position    Int     @default(0)

  menu RoleMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, roleId])
  @@index([menuId])
}

// Kênh voice "vào để tạo phòng" (thay VoiceMaster).
model TempVoiceHub {
  channelId    String   @id
  categoryId   String?
  nameTemplate String   @default("🔊 Phòng của {user}")
  userLimit    Int      @default(0)
  createdAt    DateTime @default(now())
}

// Phòng voice tạm đang sống. Lưu DB chứ không chỉ trong RAM: bot restart giữa lúc
// có 5 phòng đang mở thì phải biết phòng nào là của mình để dọn, nếu không những
// phòng đó sống mãi và server đầy kênh rác.
model TempVoiceChannel {
  channelId String   @id
  hubId     String
  ownerId   String
  locked    Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Tag / câu trả lời sẵn. autoTrigger biến nó thành autoresponder.
model Tag {
  name        String   @id // đã lowercase
  content     String
  autoTrigger String? // từ khoá trong tin nhắn thường sẽ kích hoạt
  uses        Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([autoTrigger])
}

// Tin nhắn ghim mềm: bot đăng lại nó xuống cuối kênh sau mỗi N tin, để nội quy kênh
// không bị đẩy lên mất.
model StickyMessage {
  channelId     String   @id
  content       String
  lastMessageId String?
  minGap        Int      @default(5) // số tin trước khi đăng lại
  pending       Int      @default(0)
  createdBy     String
  updatedAt     DateTime @updatedAt
}

// Starboard: tin được nhiều người thả sao thì được đăng lại vào kênh lưu niệm.
model StarboardPost {
  sourceMessageId    String   @id
  starboardMessageId String
  sourceChannelId    String
  authorId           String
  stars              Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([authorId])
}

// Trạng thái AFK. Ai ping người đang AFK sẽ được bot nhắc.
model AfkStatus {
  userId String   @id
  reason String
  since  DateTime @default(now())
}

// ============================================================
//  QUẢN LÝ TẦNG 2
// ============================================================

// Người đang bị theo dõi: mọi tin của họ được copy sang kênh log tới khi hết hạn.
//
// Có `expiresAt` bắt buộc (không nullable) là có chủ đích: theo dõi vô thời hạn là thứ
// người ta bật rồi quên, và một danh sách theo dõi bị quên là dữ liệu cá nhân bị thu
// thập mãi mà không ai còn nhớ vì sao.
model WatchTarget {
  userId    String   @id
  actorId   String
  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Kênh đang bị lockdown. Cần bảng chứ không chỉ đọc lại permission overwrite: bot phải
// biết kênh nào CHÍNH NÓ đã khoá, để `/lockdown lift` không gỡ luôn những overwrite mà
// admin đã đặt tay từ trước.
model ChannelLock {
  channelId String   @id
  actorId   String
  reason    String?
  createdAt DateTime @default(now())
}

// Role cấp tự động cho mọi người mới vào server.
model AutoRole {
  roleId    String   @id
  addedBy   String
  createdAt DateTime @default(now())
}

// Role có hạn. Unique (userId, roleId) để gia hạn là ghi đè hạn cũ, không sinh dòng
// thứ hai — hai dòng cho cùng một role nghĩa là dòng hết hạn trước sẽ gỡ role mà dòng
// còn lại vẫn tưởng là đang có.
model TempRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    String
  expiresAt DateTime
  grantedBy String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([expiresAt])
}

// Từ khoá theo dõi cá nhân: ai nhắc từ này thì người đặt nhận DM kèm ngữ cảnh.
model Highlight {
  id      Int    @id @default(autoincrement())
  userId  String
  keyword String

  @@unique([userId, keyword])
  @@index([keyword])
}

// Kênh tự mở thread cho mỗi tin nhắn.
model AutoThreadChannel {
  channelId      String   @id
  nameTemplate   String   @default("{user}")
  archiveMinutes Int      @default(1440)
  createdBy      String
  createdAt      DateTime @default(now())
}

// ============================================================
//  TICKET · KÊNH THỐNG KÊ · THỜI GIAN VOICE
// ============================================================

// Cấu hình ticket, một dòng cho mỗi server (cùng mẫu với AutomodSetting).
model TicketConfig {
  guildId        String   @id
  categoryId     String?
  staffRoleId    String?
  panelChannelId String?
  panelMessageId String?
  maxPerUser     Int      @default(2)
  updatedAt      DateTime @updatedAt
}

// Một ticket đang mở hoặc đã đóng. `channelId` unique để nút trong kênh tra ngược được
// ticket của chính nó mà không cần tin vào customId.
model Ticket {
  id        Int       @id @default(autoincrement())
  channelId String    @unique
  openerId  String
  topic     String
  claimedBy String?
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([openerId, closedAt])
}

// Kênh voice chỉ dùng làm nhãn hiển thị số liệu. Tên kênh được bot cập nhật định kỳ.
model StatsChannel {
  channelId String   @id
  kind      String // members | humans | bots | online | voice | boosts
  label     String
  createdBy String
  createdAt DateTime @default(now())
}

// Thời gian trong voice, TỔNG DỒN một dòng mỗi người.
//
// Không ghi nhật ký từng phiên: bảng đó phình vô hạn và không truy vấn nào cần tới nó.
// `weekSeconds` reset khi `weekKey` đã lưu khác tuần hiện tại — reset lúc GHI nên không
// cần một scheduler quét cả bảng vào nửa đêm Chủ nhật.
model VoiceActivity {
  userId       String   @id
  totalSeconds Int      @default(0)
  weekKey      String
  weekSeconds  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([totalSeconds])
  @@index([weekKey, weekSeconds])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id // Discord User ID
  // Hệ thống Level
  xp            Int      @default(0)
  level         Int      @default(1)
  totalMessages Int      @default(0)
  expertScore   Int      @default(0)
  contributionScore Int @default(0)
  scoinBalance  Int      @default(0)
  scoinEarnedTotal Int   @default(0)
  // Hệ thống Daily
  lastDaily     DateTime?
  dailyStreak   Int      @default(0)
  // Nhiệm vụ ngày: streak = số ngày liên tiếp hoàn thành đủ quest trong ngày
  questStreak   Int      @default(0)
  lastQuestDay  String?  // ngày (Asia/Saigon, yyyy-MM-dd) gần nhất hoàn thành đủ quest
  createdAt     DateTime @default(now())
  // Onboarding / freelancer retention (Phase 5)
  joinedAt      DateTime? // persisted on guildMemberAdd; enables 7-day retention metric
  hasPortfolio  Boolean  @default(false) // set on first portfolio post (first-portfolio detection)
  verifiedAt    DateTime? // set when a mod approves the Verified Freelancer role

  scoinTransactions ScoinTransaction[]
  musicPlaylistTracks MusicPlaylistTrack[]
  starInventory StarInventory?
  starItems StarItemStack[]
  starTools StarTool[]
  starBuffs StarBuff[]
  giveawayEntries GiveawayEntry[]
  requestClaims RequestClaim[]
  requestReviews RequestReview[] @relation("RequestReviewer")
  receivedRequestReviews RequestReview[] @relation("RequestReviewTarget")
  memberFacts MemberFact[]
  dailyQuests DailyQuest[]
  shopPurchases ShopPurchase[]
  weeklyActivity WeeklyActivity[]
  birthday Birthday?
}

model GuildSettings {
  guildId    String   @id
  locale     String   @default("vi")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Blacklist {
  id        String   @id // Discord User ID
  reason    String
  addedBy   String
  createdAt DateTime @default(now())
}

model Vote {
  id             Int      @id @default(autoincrement())
  messageId      String
  channelId      String
  targetAuthorId String
  voterId        String
  value          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([messageId, voterId])
  @@index([channelId])
  @@index([targetAuthorId])
}

model ShowcasePost {
  messageId     String   @id
  channelId     String
  authorId      String
  title         String
  tagName       String   @default("Nothing")
  status        String   @default("VOTING")
  forumThreadId String?
  dmMessageId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@index([authorId])
  @@index([status])
}

model MaintenanceLog {
  id        Int      @id @default(autoincrement())
  channelId String
  kind      String
  period    String
  actorId   String?
  createdAt DateTime @default(now())

  @@unique([channelId, kind, period])
}

model ManagedChannel {
  key       String   @id
  channelId String
  updatedAt DateTime @updatedAt
}

model ScoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int
  reason    String
  source    String
  metadata  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([createdAt])
}

model MusicPlaylistTrack {
  id        Int      @id @default(autoincrement())
  userId    String
  position  Int
  title     String
  uri       String
  source    String?
  duration  Int?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([userId])
}

model StarInventory {
  userId       String   @id
  dust         Int      @default(0)
  small        Int      @default(0)
  bright       Int      @default(0)
  comet        Int      @default(0)
  galaxy       Int      @default(0)
  lastHuntAt   DateTime?
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StarItemStack {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model StarTool {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model StarBuff {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StarHarvestSession {
  id        Int      @id @default(autoincrement())
  userId    String
  toolKey   String
  result    String
  soldValue Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Giveaway {
  id              Int      @id @default(autoincrement())
  messageId       String?  @unique
  channelId       String
  title           String
  description     String
  prize           String
  hostId          String
  pingRoleId      String?
  winnersCount    Int
  endsAt          DateTime
  status          String   @default("ACTIVE")
  requiredRoleId  String?
  minLevel        Int?
  minScoin        Int?
  entryCost       Int      @default(0)
  rewardType      String   @default("contact_host")
  rewardSecret    String?
  publicMediaUrl  String?
  bannerUrl       String?
  winnerIds       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries         GiveawayEntry[]
  deliveries      GiveawayRewardDelivery[]

  @@index([status])
  @@index([endsAt])
}

model GiveawayEntry {
  id          Int      @id @default(autoincrement())
  giveawayId  Int
  userId      String
  entries     Int      @default(1)
  joinedAt    DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@index([userId])
}

model GiveawayRewardDelivery {
  id          Int      @id @default(autoincrement())
  giveawayId  Int
  userId      String
  status      String
  error       String?
  createdAt   DateTime @default(now())

  giveaway    Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@index([giveawayId])
  @@index([userId])
}

model RequestPost {
  id            Int      @id @default(autoincrement())
  messageId     String?  @unique
  channelId     String
  requesterId   String
  kind          String
  service       String
  skill         String?
  description   String
  budget        String?
  other         String?
  status        String   @default("OPEN")
  claimedById   String?
  completedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  claims        RequestClaim[]
  reviews       RequestReview[]

  @@index([requesterId])
  @@index([status])
  @@index([kind])
}

model RequestClaim {
  id          Int      @id @default(autoincrement())
  requestId   Int
  claimerId   String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     RequestPost @relation(fields: [requestId], references: [id], onDelete: Cascade)
  claimer     User        @relation(fields: [claimerId], references: [id], onDelete: Cascade)

  @@unique([requestId, claimerId])
  @@index([claimerId])
  @@index([status])
}

model RequestReview {
  id          Int      @id @default(autoincrement())
  requestId   Int
  reviewerId  String
  targetId    String
  rating      Int
  note        String?
  createdAt   DateTime @default(now())

  request     RequestPost @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("RequestReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  target      User        @relation("RequestReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requestId, reviewerId])
  @@index([targetId])
}

model FacebookCrossPost {
  id              Int      @id @default(autoincrement())
  sourceChannelId String   // channel of the source Discord message (for live URL re-fetch)
  sourceMessageId String   // source message id — re-fetch a LIVE signed URL at approval time
  authorId        String
  caption         String
  status          String   @default("PENDING") // PENDING | PUBLISHING | PUBLISHED | DISCARDED | NEEDS_REVIEW
  fbPostId        String?
  lastError       String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model WikiEntry {
  name      String   @id // lowercased plugin key
  url       String
  aliases   String?  // optional CSV of alternate names
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberFact {
  id        Int      @id @default(autoincrement())
  userId    String
  fact      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fact])
  @@index([userId])
}

// Nhiệm vụ ngày: mỗi người 3 quest ngẫu nhiên / ngày (gán lazy khi có hoạt động
// đầu tiên). Hoàn thành tự cộng Scoin; unique chặn gán trùng khi race.
model DailyQuest {
  id        Int      @id @default(autoincrement())
  userId    String
  day       String   // ngày Asia/Saigon, yyyy-MM-dd
  questKey  String   // khóa catalog trong quest-manager (chat/daily/trivia/vote/star)
  target    Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  reward    Int      // Scoin trả khi hoàn thành

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, questKey])
  @@index([userId, day])
}

// Role màu do Stella tự tạo cho Shop; lưu id để tái dùng thay vì tạo lại.
model ShopColorRole {
  key       String   @id // khóa màu trong config.shop.colors
  roleId    String
  createdAt DateTime @default(now())
}

// Nhật ký mua hàng Shop (đối soát; số dư trừ qua ScoinTransaction).
model ShopPurchase {
  id        Int      @id @default(autoincrement())
  userId    String
  itemKey   String
  price     Int
  // PENDING = đã trừ xu, chưa giao xong. DELIVERED = đã giao. REFUNDED = đã hoàn xu.
  // Trạng thái là thứ chặn "hoàn xu rồi vẫn đổi được hàng": đơn REFUNDED không còn
  // là bằng chứng đã trả tiền. Không có nó thì hoàn xu và nhận hàng là hai đường
  // độc lập, đi cả hai là được hàng miễn phí.
  status      String    @default("DELIVERED")
  deliveredAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, itemKey])
}

// Hoạt động theo tuần (weekKey = ngày thứ 2 đầu tuần Asia/Saigon, yyyy-MM-dd).
// Cộng dồn từ hook XP; dùng để xếp hạng thưởng tuần.
model WeeklyActivity {
  userId   String
  weekKey  String
  messages Int    @default(0)
  xp       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, weekKey])
  @@index([weekKey])
}

// Chốt mỗi tuần chỉ trao thưởng 1 lần: insert (unique weekKey) TRƯỚC khi trao —
// restart giữa chừng không thể trao lần 2.
model WeeklyRewardRun {
  weekKey String   @id
  ranAt   DateTime @default(now())
}

// Sinh nhật thành viên tự đăng ký. lastCelebratedYear chặn chúc trùng trong năm.
model Birthday {
  userId             String   @id
  day                Int
  month              Int
  lastCelebratedYear Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month, day])
}

// Bản tóm tắt trung gian của nhật báo: mỗi 3h một "slot" (0..7) được tóm tắt và
// lưu ở đây, KHÔNG đăng lên kênh. Cuối ngày 8 slot được gộp lại thành bản tin
// hoàn chỉnh. Lưu ở DB thay vì file tạm vì host là shared hosting — filesystem
// có thể bị xoá khi restart, còn Postgres là nguồn bền duy nhất của bot.
// summary rỗng + msgCount 0 = slot đó thật sự không có chat (đã kiểm tra, không
// phải lỗi) — ghi lại để scheduler không thử lại vô hạn.
model ReportChunk {
  id        Int      @id @default(autoincrement())
  period    String // ngày theo timezone cấu hình, yyyy-MM-dd
  slot      Int // 0..7, mốc 3 giờ
  summary   String
  msgCount  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([period, slot])
  @@index([period])
}

// BÀI nhật báo ĐÃ ĐĂNG (bản tin ngày hoàn chỉnh, không phải chunk trung gian).
// Chunk 3h bị prune sau 7 ngày và không phải là bài hoàn chỉnh — bài tổng hợp
// tuần (report-weekly) cần đọc lại các bài ngày, nên bài đăng xong phải được lưu
// riêng ở đây. Prune 35 ngày (xem report-daily-store.ts) — 1 row/ngày, không lo phình.
model ReportDaily {
  id        Int      @id @default(autoincrement())
  period    String   @unique // ngày theo timezone cấu hình, yyyy-MM-dd
  body      String
  createdAt DateTime @default(now())
}

// Lời nhắc do member nhờ Stella ping hộ, đặt bằng câu nói thường trong `!s`.
//
// Vì sao phải lưu DB chứ không setTimeout: một lời nhắc "3h chiều nay" đặt lúc
// 9h sáng phải sống qua mọi lần bot restart/deploy giữa khoảng đó. setTimeout
// mất trắng khi process chết, và mất một lời nhắc thì người ta không biết là
// mình đã bị quên — đúng kiểu thất bại tệ nhất cho một tính năng nhắc nhở.
//
// requesterId TÁCH RIÊNG targetId là chốt quyền, không phải để thống kê: chỉ
// role được cấp mới đặt được lời nhắc cho NGƯỜI KHÁC, còn ai cũng đặt được cho
// chính mình. Thiếu tách hai cột này thì không truy được ai đã nhờ ping ai.
model Reminder {
  id          Int       @id @default(autoincrement())
  requesterId String // ai nhờ đặt (dùng để truy vết và kiểm quyền)
  targetId    String // ai bị ping khi tới giờ
  channelId   String // ping ở kênh nào (mặc định kênh chat)
  message     String // nội dung nhắc, do người đặt nói
  // Mốc giờ TIẾP THEO cần ping, tính sẵn theo giờ VN rồi lưu về UTC. Lưu mốc
  // tuyệt đối thay vì "3h chiều" dạng chữ để scheduler chỉ cần so sánh thời
  // gian, không phải parse lại tiếng Việt mỗi phút.
  nextFireAt  DateTime
  // Lặp hằng ngày hay chỉ một lần. Lời nhắc một lần được đánh done sau khi ping;
  // lời lặp thì dời nextFireAt sang cùng giờ ngày mai.
  repeatDaily Boolean   @default(false)
  // Giờ/phút theo giờ VN, giữ lại RIÊNG cho lời lặp: cộng thêm 24h vào mốc UTC
  // sẽ lệch nếu múi giờ đổi, còn dựng lại từ giờ-phút thì luôn đúng "1h chiều
  // theo giờ Hà Nội" bất kể chuyện gì xảy ra với offset.
  hourVn      Int
  minuteVn    Int       @default(0)
  active      Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Chỉ quét lời nhắc còn sống và đã tới hạn.
  @@index([active, nextFireAt])
  @@index([targetId])
}

// Tên gợi nhớ: "Ri" -> user id thật. Để Saly nói "nhắc Ri đi tắm" mà không phải
// ping, vì ping thì phải mở danh sách member tìm đúng người — đúng cái việc mà
// tính năng nhắc nhở định bỏ đi.
//
// Vì sao là bảng DB chứ không phải hằng trong config: thêm một tên là việc Saly
// làm lúc đang chat, còn sửa config thì phải deploy lại bot. Lưu DB nên thêm được
// bằng lệnh và sống qua restart.
//
// alias là khoá chính đã lowercase: tra tên phải không phân biệt hoa thường ("ri",
// "Ri", "RI" là một người), mà so sánh lowercase trên khoá tự nhiên thì DB tự
// chặn trùng luôn — không cần thêm chốt ở tầng code.
model ReminderAlias {
  alias     String   @id // đã lowercase
  userId    String // người mà tên này chỉ tới
  // Ai thêm. Giữ lại để truy vết: một tên trỏ sai người sẽ ping oan người đó mỗi
  // ngày, nên phải biết ai đặt để hỏi lại.
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Thuật ngữ cộng đồng mà Stella chưa hiểu. Vòng đời: phát hiện trong chat (kèm
// lượt tóm tắt chunk, không tốn AI call riêng) -> hỏi ở kênh knowledge -> chỉ ghi
// nghĩa khi NGƯỜI CÓ ROLE TIN CẬY trả lời. answeredBy + sourceMsg để truy vết và
// xoá được khi bị dạy sai — một nghĩa sai sẽ được tái dùng ở mọi bản tin sau, nên
// phải sửa được. askedAt/askCount để không hỏi lại cùng một từ mỗi 3 tiếng.
model GlossaryTerm {
  term       String    @id // đã lowercase, dùng làm khoá tự nhiên
  meaning    String? // null = đã hỏi nhưng chưa ai trả lời
  answeredBy String? // Discord user id của người giải thích
  sourceMsg  String? // message id để truy vết nguồn
  askedAt    DateTime?
  askCount   Int       @default(0)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([answeredAt])
}

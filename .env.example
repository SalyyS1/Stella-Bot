BOT_TOKEN=
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
# ISOLATED scratch DB for `npm run test:money` — a Neon BRANCH or local Postgres.
# NEVER set this to the production DATABASE_URL: the test harness truncates all tables.
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@BRANCH-HOST.neon.tech/DBNAME?sslmode=require"
# So connection Prisma duoc mo. Pooler Supabase o session mode chi cho 15 client cho ca
# project, va Prisma khong co tran thi tu lay `physical_cpus * 2 + 1` roi giu idle mai —
# bot mot minh lam day pooler, migration va script backup het slot. Mac dinh 10, chua 5.
# DB_CONNECTION_LIMIT=10
CLIENT_ID=
GUILD_ID=
MUSIC_PREFIX=s!
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Optional for hosting or failover. If set, this JSON overrides LAVALINK_HOST/LAVALINK_PORT.
# LAVALINK_NODES=[{"id":"Remote Main","host":"lavalink.example.com","port":443,"authorization":"password","secure":true}]
# Lavalink deployment env, only used by lavalink-host/start.sh. Required: use a
# long random value and copy the same value to LAVALINK_PASSWORD/LAVALINK_NODES.
LAVALINK_SERVER_PASSWORD=
LAVALINK_VERSION=4.2.2
JAVA_OPTS=-Xmx768m
# SponsorBlock bỏ đoạn sponsor/tự quảng cáo trong chính video YouTube (quảng cáo
# pre-roll của YouTube thì Lavalink vốn không stream). Mặc định bật; đặt =0 nếu
# node Lavalink không có plugin sponsorblock.
MUSIC_SPONSORBLOCK=1
# Spotify do plugin LavaSrc xử lý BÊN TRONG Lavalink, không phải trong bot.
# Local Docker: docker-compose.lavalink.yml đọc 2 biến này từ đây rồi truyền vào
# container. Lavalink remote: phải đặt 2 biến ở panel chạy Lavalink, để ở đây
# không có tác dụng gì.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube chặn playback từ IP lạ ("Sign in to confirm you're not a bot"). Bật oauth
# trong application.yml là hết, nhưng phải authorize một lần: để trống biến này rồi
# start Lavalink, log sẽ in link google.com/device + code; authorize xong log in ra
# refreshToken, dán vào đây để khỏi làm lại mỗi lần restart. Dùng account rác.
# Cùng quy tắc như Spotify: Lavalink remote thì đặt biến này ở panel chạy Lavalink.
YOUTUBE_REFRESH_TOKEN=
# Bot "loa phụ" để phát song song ở nhiều kênh voice. Discord chỉ cho MỘT bot
# user ở MỘT kênh voice trong một server, nên muốn kênh voice 1 và kênh voice 2
# phát 2 bài khác nhau thì phải có thêm token bot khác. Mỗi token = thêm 1 kênh
# phát cùng lúc. Bot phụ phải được mời vào server và có quyền Connect/Speak.
# Nhiều token phân tách bằng dấu phẩy. Là secret: không commit, không log.
MUSIC_SATELLITE_TOKENS=
# Kênh Discord để Stella lưu ảnh bìa playlist do member UPLOAD (bot đăng lại ảnh
# vào đây rồi lưu message id). Cần vì URL file đính kèm của Discord có signature
# hết hạn sau vài ngày — lưu URL thẳng thì vài ngày sau ảnh bìa chết.
# Thiếu biến này thì member vẫn đặt được ảnh bìa bằng cách dán link https.
MUSIC_ASSET_CHANNEL_ID=
# Facebook cross-post (Phase 7). Requires a Facebook App with pages_manage_posts
# (Meta App Review + Business Verification — can take weeks). Feature stays OFF
# until FB_CROSSPOST_ENABLED=true AND both FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN set.
# The token is a long-lived Page token; keep it secret, never commit it.
FB_CROSSPOST_ENABLED=false
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# AI (Report + Q&A). OpenAI-compatible endpoint (agentgw.cloud). Feature stays
# OFF until AI_API_KEY + AI_BASE_URL + AI_MODEL are all set. Key is a secret:
# keep it in .env only, never commit, never log.
AI_API_KEY=
AI_BASE_URL=https://agentgw.cloud/v1
AI_MODEL=agentgw-opus-4-8
# AI image generation (/imagine). OpenAI-compatible images endpoint, separate
# provider/key from the text AI above. Feature stays OFF until IMAGE_API_KEY is
# set. Key is a secret: keep it in .env only, never commit/log.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://your-image-gateway.example.com/v1
IMAGE_MODEL=antigravity/gemini-3.1-flash-image
# Discord user id của chủ server. Nhật báo dùng để ping gợi ý sản phẩm, và
# /plugin dùng để gửi jar chờ duyệt. Thiếu thì cả 2 tự tắt — CỐ Ý không
# hardcode id người thật vào repo.
OWNER_USER_ID=
# Web research cho nhật báo (Tavily-compatible). Thiếu thì phần tra web tắt
# hoàn toàn, bản tin vẫn ra bình thường.
RESEARCH_API_KEY=
# Build jar cho /plugin. Jar được build TRÊN GitHub Actions, không build ở host
# bot: script build Gradle là chương trình chạy code tuỳ ý, đặt cạnh bot là đặt
# BOT_TOKEN + DATABASE_URL + AI_API_KEY vào cùng bán kính nổ.
#
# PLUGIN_BUILD_REPO: repo chứa .github/workflows/build-plugin.yml, dạng "owner/repo".
# PLUGIN_BUILD_TOKEN: GitHub PAT có quyền actions:write trên repo đó. Là secret,
#   chỉ để trong .env, không commit, không log.
# Thiếu 1 trong 2 thì /plugin vẫn chạy nhưng chỉ trả mã nguồn (fail-closed).
PLUGIN_BUILD_REPO=
PLUGIN_BUILD_TOKEN=
# Nhánh chứa workflow. Workflow phải có mặt trên nhánh này TRƯỚC khi gọi, không
# thì workflow_dispatch trả 404.
PLUGIN_BUILD_REF=main
# Jar do AI viết mà phát dưới tên studio thì trách nhiệm là của Saly, nên mặc
# định jar gửi riêng cho OWNER_USER_ID để duyệt, member chỉ nhận thông báo chờ.
# Đặt =off để phát jar trực tiếp cho member (KHÔNG khuyến khích).
PLUGIN_BUILD_REVIEW=on

# --- Link tải hàng số bán bằng scoin (/shop hangso) ---
# Đặt link ở ĐÂY, không đặt trong src/config.ts: config đi vào git, nên link nằm
# trong đó là ai clone repo cũng có, kể cả người chưa trả xu.
# Món không có link sẽ không bán được (fail-closed) thay vì gửi link rỗng.
SHOP_LINK_PLUGIN_STELLA_UTILS=
SHOP_LINK_DOCS_SERVER_SETUP=

# --- Panel quản trị (chạy trong cùng process với bot) ---
# Mặc định TẮT. Bật panel là mở một port ra mạng từ chính process đang giữ kết
# nối Discord: web bị flood là bot rời gateway. Bật phải là việc có chủ ý.
PANEL_ENABLED=false
PANEL_PORT=8080
# 127.0.0.1 = chỉ vào được từ chính máy chủ (qua SSH tunnel). Đổi sang 0.0.0.0
# CHỈ khi đã có HTTPS đứng trước (domain của host, hoặc Cloudflare Tunnel):
# cookie session đi qua HTTP thường là cookie ai trên đường truyền cũng đọc được,
# và đọc được là vào panel admin của cả server.
PANEL_HOST=127.0.0.1
# Chỉ bật khi THẬT SỰ có proxy (Cloudflare Tunnel, nginx) đứng trước. Bật khi
# không có proxy là cho phép người ta tự khai IP qua header và vượt mọi giới hạn
# tính theo IP.
PANEL_TRUST_PROXY=false

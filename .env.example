BOT_TOKEN=
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
# ISOLATED scratch DB for `npm run test:money` — a Neon BRANCH or local Postgres.
# NEVER set this to the production DATABASE_URL: the test harness truncates all tables.
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@BRANCH-HOST.neon.tech/DBNAME?sslmode=require"
CLIENT_ID=
GUILD_ID=
MUSIC_PREFIX=s!
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Optional for hosting or failover. If set, this JSON overrides LAVALINK_HOST/LAVALINK_PORT.
# LAVALINK_NODES=[{"id":"Remote Main","host":"lavalink.example.com","port":443,"authorization":"password","secure":true}]
# Lavalink deployment env, only used by lavalink-host/start.sh. Required: use a
# long random value and copy the same value to LAVALINK_PASSWORD/LAVALINK_NODES.
LAVALINK_SERVER_PASSWORD=
LAVALINK_VERSION=4.2.2
JAVA_OPTS=-Xmx768m
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Facebook cross-post (Phase 7). Requires a Facebook App with pages_manage_posts
# (Meta App Review + Business Verification — can take weeks). Feature stays OFF
# until FB_CROSSPOST_ENABLED=true AND both FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN set.
# The token is a long-lived Page token; keep it secret, never commit it.
FB_CROSSPOST_ENABLED=false
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# AI (Report + Q&A). OpenAI-compatible endpoint (agentgw.cloud). Feature stays
# OFF until AI_API_KEY + AI_BASE_URL + AI_MODEL are all set. Key is a secret:
# keep it in .env only, never commit, never log.
AI_API_KEY=
AI_BASE_URL=https://agentgw.cloud/v1
AI_MODEL=agentgw-opus-4-8
# AI image generation (/imagine). OpenAI-compatible images endpoint, separate
# provider/key from the text AI above. Feature stays OFF until IMAGE_API_KEY is
# set. Key is a secret: keep it in .env only, never commit/log.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://your-image-gateway.example.com/v1
IMAGE_MODEL=antigravity/gemini-3.1-flash-image
